# Required: OpenRouter key. Used directly to call OpenRouter's chat/completions
# API (llm_wiki.llm.query_LLM).
OPENROUTER_API_KEY=

# Optional overrides (defaults shown).
# LLM_WIKI_MODEL=openai/gpt-oss-120b
# LLM_WIKI_TEMPERATURE=0.1
# LLM_WIKI_MAX_TOKENS=8192
# LLM_WIKI_RAW_DIR=./raw
# LLM_WIKI_WIKI_DIR=./wiki
# PostgreSQL connection URL. The database server (with the pgvector extension)
# is expected to run elsewhere; this app only connects to it.
# LLM_WIKI_DB_URL=postgresql://llm_wiki:llm_wiki@localhost:5432/llm_wiki

# Attempts to get schema-valid JSON out of a single LLM step.
# LLM_WIKI_JSON_RETRIES=2
# Refine attempts before an item/page is flagged needs_review.
# LLM_WIKI_REVIEW_RETRIES=2

# LLM_WIKI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Entity resolution funnel. Candidate retrieval is recall-oriented (loose); the
# LLM judge makes the final call.
# Candidate retrieval:
# LLM_WIKI_EMBEDDING_CANDIDATE_THRESHOLD=0.45   # max cosine distance to be a candidate
# LLM_WIKI_STRING_CANDIDATE_THRESHOLD=80        # min token_sort_ratio (0-100) to be a candidate
# LLM_WIKI_RESOLVE_CANDIDATE_LIMIT=5            # candidates handed to the judge
