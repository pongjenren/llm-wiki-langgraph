# Required: OpenRouter key. Used directly to call OpenRouter's chat/completions
# API (llm_wiki.llm.query_LLM).
OPENROUTER_API_KEY=

# Optional overrides (defaults shown).
# LLM_WIKI_MODEL=openai/gpt-oss-120b
# LLM_WIKI_TEMPERATURE=0.1
# LLM_WIKI_MAX_TOKENS=8192
# LLM_WIKI_RAW_DIR=./raw
# LLM_WIKI_WIKI_DIR=./wiki
# LLM_WIKI_DB=./llm_wiki.db

# Attempts to get schema-valid JSON out of a single LLM step.
# LLM_WIKI_JSON_RETRIES=2
# Refine attempts before an item/page is flagged needs_review.
# LLM_WIKI_REVIEW_RETRIES=2

# LLM_WIKI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Cosine distance below which an existing page counts as the same entity.
# LLM_WIKI_SIMILARITY_THRESHOLD=0.25
