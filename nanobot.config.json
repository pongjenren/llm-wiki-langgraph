{
  "providers": {
    "openrouter": {
      "apiKey": "${OPENROUTER_API_KEY}"
    }
  },
  "modelPresets": {
    "wiki": {
      "label": "llm-wiki ingest",
      "provider": "openrouter",
      "model": "openai/gpt-oss-120b",
      "temperature": 0.1,
      "maxTokens": 8192
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "wiki",
      "maxToolIterations": 1
    }
  },
  "tools": {
    "web": { "enable": false },
    "exec": { "enable": false },
    "file": { "enable": false },
    "my": { "enable": false },
    "cliApps": { "enable": false },
    "imageGeneration": { "enabled": false }
  }
}
